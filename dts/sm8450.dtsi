// SPDX-License-Identifier: BSD-3-Clause
// Resources from linux-next arch/arm64/boot/dts/qcom/sm8450.dtsi (075b74841bd0).
/ {
    compatible = "qcom,sm8450";
    #address-cells = <2>;
    #size-cells = <2>;
    interrupt-parent = <&gic>;

    cpus {
        #address-cells = <2>;
        #size-cells = <0>;
        timebase-frequency = <19200000>;
        cpu0: cpu@0 { device_type = "cpu"; compatible = "arm,cortex-a510"; reg = <0 0>; };
        cpu1: cpu@100 { device_type = "cpu"; compatible = "arm,cortex-a510"; reg = <0 0x100>; };
        cpu2: cpu@200 { device_type = "cpu"; compatible = "arm,cortex-a510"; reg = <0 0x200>; };
        cpu3: cpu@300 { device_type = "cpu"; compatible = "arm,cortex-a510"; reg = <0 0x300>; };
        cpu4: cpu@400 { device_type = "cpu"; compatible = "arm,cortex-a710"; reg = <0 0x400>; };
        cpu5: cpu@500 { device_type = "cpu"; compatible = "arm,cortex-a710"; reg = <0 0x500>; };
        cpu6: cpu@600 { device_type = "cpu"; compatible = "arm,cortex-a710"; reg = <0 0x600>; };
        cpu7: cpu@700 { device_type = "cpu"; compatible = "arm,cortex-x2"; reg = <0 0x700>; };
    };

    psci { compatible = "arm,psci-1.0"; method = "smc"; };

    soc: soc {
        compatible = "simple-bus";
        #address-cells = <2>;
        #size-cells = <2>;
        ranges;

        gic: interrupt-controller@17100000 {
            compatible = "arm,gic-v3";
            unixnu,adt-name = "intc";
            reg = <0 0x17100000 0 0x10000>, <0 0x17180000 0 0x200000>;
            #interrupt-cells = <3>;
            #address-cells = <0>;
            interrupt-controller;
            redistributor-stride = <0 0x40000>;
        };

        apps_smmu: iommu@15000000 {
            compatible = "qcom,sm8450-smmu-500", "arm,mmu-500";
            unixnu,adt-name = "apps-smmu";
            reg = <0 0x15000000 0 0x100000>;
            #iommu-cells = <2>;
            status = "disabled";
        };

        ufs: ufshc@1d84000 {
            compatible = "qcom,sm8450-ufshc", "qcom,ufshc", "jedec,ufs-2.0";
            unixnu,adt-name = "ufshc";
            reg = <0 0x1d84000 0 0x3000>;
            // No interrupts (Linux: SPI 265): ShengUfs polls, and XNU resolves interrupt-parent through
            // AAPL,phandle, which the ADT generator does not emit.
            iommus = <&apps_smmu 0xe0 0x0>;
            dma-coherent;
            status = "disabled";
        };

        ufsphy: phy@1d87000 {
            compatible = "qcom,sm8450-qmp-ufs-phy";
            unixnu,adt-name = "ufsphy";
            reg = <0 0x1d87000 0 0x1000>;
            status = "disabled";
        };

        // No interrupts on the GPU, GMU and GPU SMMU either (Linux: SPI 300; 304/305; 673...): see ufshc.
        gpu: gpu@3d00000 {
            compatible = "qcom,adreno-730.1", "qcom,adreno";
            reg = <0 0x3d00000 0 0x40000>, <0 0x3d9e000 0 0x1000>, <0 0x3d61000 0 0x800>;
            reg-names = "kgsl_3d0_reg_memory", "cx_mem", "cx_dbgc";
            iommus = <&gpu_smmu 0 0x400>, <&gpu_smmu 1 0x400>;
            status = "disabled";
        };

        gmu: gmu@3d6a000 {
            compatible = "qcom,adreno-gmu-730.1", "qcom,adreno-gmu";
            reg = <0 0x3d6a000 0 0x35000>, <0 0x3d50000 0 0x10000>, <0 0xb290000 0 0x10000>;
            reg-names = "gmu", "rscc", "gmu_pdc";
            iommus = <&gpu_smmu 5 0x400>;
            status = "disabled";
        };

        gpu_smmu: iommu@3da0000 {
            compatible = "qcom,sm8450-smmu-500", "qcom,adreno-smmu", "qcom,smmu-500", "arm,mmu-500";
            reg = <0 0x3da0000 0 0x40000>;
            #iommu-cells = <2>;
            status = "disabled";
        };
    };
};
